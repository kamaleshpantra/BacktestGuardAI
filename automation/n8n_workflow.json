{
  "name": "BacktestGuard_AI_Market_Close_Audit",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 16 * * 1-5"
            }
          ]
        }
      },
      "name": "Market Close Cron (4:30 PM M-F)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://query1.finance.yahoo.com/v7/finance/download/AAPL?interval=1d&events=history",
        "options": {}
      },
      "name": "Fetch Latest Market CSV (AAPL)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/validate/dataset",
        "sendBinaryData": true,
        "binaryPropertyName": "data",
        "options": {}
      },
      "name": "BacktestGuard Audit API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json[\"passed\"]}}",
              "value2": true
            }
          ]
        }
      },
      "name": "Data Passed Integrity?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        920,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "={{$node[\"Configure Credentials\"].json[\"chat_id\"]}}",
        "text": "=🛡️ *BacktestGuard AI — Daily Audit Passed*\n\nAsset: AAPL\nRows Checked: {{$json[\"row_count\"]}}\nErrors: 0\nStatus: ✅ All candle geometries and timestamps clean.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "name": "Telegram: Send Success Report",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [
        1150,
        200
      ]
    },
    {
      "parameters": {
        "chatId": "={{$node[\"Configure Credentials\"].json[\"chat_id\"]}}",
        "text": "=🚨 *BacktestGuard AI — DATA ANOMALY DETECTED*\n\nAsset: AAPL\nStatus: ❌ FAILED\n\nIssues Found:\n{{JSON.stringify($json[\"errors\"], null, 2)}}\n\nSimulation halted to protect capital.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "name": "Telegram: Send Anomaly Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [
        1150,
        420
      ]
    }
  ],
  "connections": {
    "Market Close Cron (4:30 PM M-F)": {
      "main": [
        [
          {
            "node": "Fetch Latest Market CSV (AAPL)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Latest Market CSV (AAPL)": {
      "main": [
        [
          {
            "node": "BacktestGuard Audit API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "BacktestGuard Audit API": {
      "main": [
        [
          {
            "node": "Data Passed Integrity?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Data Passed Integrity?": {
      "main": [
        [
          {
            "node": "Telegram: Send Success Report",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Telegram: Send Anomaly Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
